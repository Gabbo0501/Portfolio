# Server
PORT=3001
NODE_ENV=development

# Comma-separated browser origins allowed by CORS in production.
# Example production value:
# CORS_ORIGINS=https://gabrielemondino.it,https://www.gabrielemondino.it
CORS_ORIGINS=http://localhost:5173

# SQLite database reset helpers. Keep disabled unless you intentionally want a fresh DB.
DB_PATH=server/database/portfolio.db
DB_RESET=0
DB_RESET_ON_SCHEMA_CHANGE=0
DB_RESET_ON_INCOMPATIBLE_SCHEMA=1
