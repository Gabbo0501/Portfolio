*.pub

# Local-only files
/comandi.txt
/scripts/

# Dependencies and build output
node_modules/
dist/
dist-ssr/
build/
coverage/

# SQLite and runtime data
*.db
*.db-shm
*.db-wal
app/server/database/portfolio.db
app/server/database/seed.local.sql

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS and editors
.DS_Store
Thumbs.db
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
